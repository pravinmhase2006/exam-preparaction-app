datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String         @unique
  password      String
  role          String         @default("USER") // USER, ADMIN
  isVerified    Boolean        @default(false)
  avatar        String?
  profile       Profile?
  bookmarks     Bookmark[]
  jobAlerts     JobAlert[]
  testAttempts  TestAttempt[]
  notifications Notification[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Profile {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String   @unique @db.ObjectId
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone              String?
  dob                String?
  state              String?
  district           String?
  qualification      String?  // 10th Pass, 12th Pass, Graduate, Diploma, ITI, Engineering, Post Graduate
  passingYear        String?
  preferredExams     String?  // JSON string array e.g. ["SSC CGL", "RRB NTPC"]
  preferredJobTypes  String?  // JSON string array e.g. ["Central Govt", "State Govt", "Banking"]
  preferredStates    String?  // JSON string array
  prepStreak         Int      @default(3)
  targetGoalYear     String?  @default("2026")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Organization {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  shortName   String      @unique
  slug        String      @unique
  logo        String?
  website     String?
  description String?
  jobs        Job[]
  exams       Exam[]
  results     Result[]
  admitCards  AdmitCard[]
  answerKeys  AnswerKey[]
  createdAt   DateTime    @default(now())
}

model State {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String @unique
  code String @unique
  jobs Job[]
}

model JobCategory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  jobs        Job[]
  createdAt   DateTime @default(now())
}

model Job {
  id                     String        @id @default(auto()) @map("_id") @db.ObjectId
  title                  String
  slug                   String        @unique
  organizationId         String        @db.ObjectId
  organization           Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department             String?
  categoryId             String        @db.ObjectId
  category               JobCategory   @relation(fields: [categoryId], references: [id])
  qualification          String        // 10th Pass, 12th Pass, Graduate, Diploma, ITI, Engineering, Any Degree
  vacancies              Int           @default(0)
  vacanciesDisplay       String?       // "17,727 Posts"
  location               String        @default("All India")
  stateId                String?       @db.ObjectId
  state                  State?        @relation(fields: [stateId], references: [id])
  salary                 String        @default("As per 7th CPC")
  jobType                String        @default("Regular / Permanent") // Permanent, Contract, Apprenticeship
  minAge                 Int?          @default(18)
  maxAge                 Int?          @default(30)
  applicationFee         String?       // "Gen/OBC: ₹100, SC/ST/Female: Nil"
  feeDetails             String?       // JSON string of category-wise fee
  applicationStart       DateTime?
  applicationEnd         DateTime?
  examDate               String?
  admitCardDate          String?
  resultDate             String?
  selectionProcess       String?       // Tier 1 CBT, Tier 2 CBT, Skill Test, Document Verification
  examPattern            String?       // JSON string of subjects & marks
  vacancyDetails         String?       // JSON string of post-wise vacancies
  eligibility            String?       // Detailed eligibility text/JSON
  applicationProcess     String?       // Step by step apply guide
  officialNotificationUrl String?
  officialWebsiteUrl     String?
  applyUrl               String?
  isFeatured             Boolean       @default(false)
  isUrgent               Boolean       @default(false)
  status                 String        @default("PUBLISHED") // DRAFT, REVIEW, PUBLISHED, SCHEDULED, EXPIRED, ARCHIVED
  views                  Int           @default(0)
  clicks                 Int           @default(0)
  applyClicks            Int           @default(0)
  seoTitle               String?
  seoDescription         String?
  seoKeywords            String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
}

model Exam {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  slug             String          @unique
  category         String          // SSC, Railway, Banking, UPSC, State PSC, Police, Defence, Teaching
  organizationId   String          @db.ObjectId
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  frequency        String          @default("Annual")
  officialWebsite  String?
  description      String?
  eligibility      String?
  ageLimit         String?
  examPattern      String?         // JSON
  syllabusOverview String?
  preparationTips  String?
  isPopular        Boolean         @default(false)
  upcomingDate     String?
  mockTests        MockTest[]
  questions        Question[]
  results          Result[]
  admitCards       AdmitCard[]
  answerKeys       AnswerKey[]
  syllabi          Syllabus[]
  previousPapers   PreviousPaper[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model Subject {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String
  questions Question[]
}

model Question {
  id                String             @id @default(auto()) @map("_id") @db.ObjectId
  examId            String?            @db.ObjectId
  exam              Exam?              @relation(fields: [examId], references: [id], onDelete: SetNull)
  subjectId         String?            @db.ObjectId
  subject           Subject?           @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic             String?
  questionText      String
  questionTextHi    String?
  questionType      String             @default("MCQ") // MCQ, TRUE_FALSE
  optionA           String
  optionB           String
  optionC           String
  optionD           String
  optionAHi         String?
  optionBHi         String?
  optionCHi         String?
  optionDHi         String?
  correctAnswer     String             // A, B, C, D
  explanation       String?
  explanationHi     String?
  difficulty        String             @default("MEDIUM") // EASY, MEDIUM, HARD
  marks             Float              @default(2.0)
  negativeMarks     Float              @default(0.5)
  language          String             @default("Bilingual") // English, Hindi, Bilingual
  imageUrl          String?
  mockTestQuestions MockTestQuestion[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model MockTest {
  id              String             @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  slug            String             @unique
  examId          String             @db.ObjectId
  exam            Exam               @relation(fields: [examId], references: [id], onDelete: Cascade)
  description     String?
  durationMinutes Int                @default(60)
  totalQuestions  Int                @default(25)
  totalMarks      Float              @default(50.0)
  passingMarks    Float              @default(20.0)
  difficulty      String             @default("Moderate")
  isFree          Boolean            @default(true)
  isPublished     Boolean            @default(true)
  attemptsCount   Int                @default(0)
  questions       MockTestQuestion[]
  testAttempts    TestAttempt[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model MockTestQuestion {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  mockTestId String   @db.ObjectId
  mockTest   MockTest @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  questionId String   @db.ObjectId
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int      @default(0)
}

model TestAttempt {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mockTestId        String   @db.ObjectId
  mockTest          MockTest @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  score             Float
  totalMarks        Float
  percentage        Float
  correctCount      Int
  incorrectCount    Int
  skippedCount      Int
  accuracy          Float
  timeTakenSeconds  Int
  answersJson       String   // JSON string recording questionId -> chosen answer & status
  isCompleted       Boolean  @default(true)
  createdAt         DateTime @default(now())
}

model Result {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  slug            String       @unique
  examId          String?      @db.ObjectId
  exam            Exam?        @relation(fields: [examId], references: [id], onDelete: SetNull)
  organizationId  String       @db.ObjectId
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resultDate      DateTime     @default(now())
  examDate        String?
  cutoffDetails   String?      // JSON or markdown
  meritListUrl    String?
  officialResultUrl String?
  status          String       @default("ANNOUNCED") // ANNOUNCED, EXPECTED, REVISED
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model AdmitCard {
  id                      String       @id @default(auto()) @map("_id") @db.ObjectId
  title                   String
  slug                    String       @unique
  examId                  String?      @db.ObjectId
  exam                    Exam?        @relation(fields: [examId], references: [id], onDelete: SetNull)
  organizationId          String       @db.ObjectId
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  examDate                String
  releaseDate             DateTime     @default(now())
  applicationRequirements String?      // e.g. Registration ID & Password / DOB
  downloadUrl             String?
  status                  String       @default("AVAILABLE") // AVAILABLE, RELEASING_SOON
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
}

model AnswerKey {
  id                String       @id @default(auto()) @map("_id") @db.ObjectId
  title             String
  slug              String       @unique
  examId            String?      @db.ObjectId
  exam              Exam?        @relation(fields: [examId], references: [id], onDelete: SetNull)
  organizationId    String       @db.ObjectId
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  releaseDate       DateTime     @default(now())
  objectionDeadline String?
  pdfUrl            String?
  objectionUrl      String?
  status            String       @default("ACTIVE") // ACTIVE, CLOSED, FINAL
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model Syllabus {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String   @unique
  examId      String   @db.ObjectId
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  tier        String   @default("Tier 1 / Prelims")
  content     String   // Structured Markdown or JSON
  downloadUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PreviousPaper {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  slug           String   @unique
  examId         String   @db.ObjectId
  exam           Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  year           Int
  subject        String
  shift          String?  @default("Morning Shift")
  language       String   @default("Hindi / English")
  pdfUrl         String?
  solutionPdfUrl String?
  questionsCount Int      @default(100)
  createdAt      DateTime @default(now())
}

model Article {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  slug         String   @unique
  excerpt      String
  content      String
  category     String   // National, International, Economy, Science, Tech, Sports, Appointments, Schemes, Days
  date         DateTime @default(now())
  tags         String?  // comma separated
  imageUrl     String?
  relatedExam  String?
  isDaily      Boolean  @default(true)
  isWeekly     Boolean  @default(false)
  isMonthly    Boolean  @default(false)
  isFeatured   Boolean  @default(false)
  views        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model StudyMaterial {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String   @unique
  category    String   // Quantitative Aptitude, Reasoning, English, General Knowledge, General Science, Computer, Marathi, Hindi
  subject     String
  author      String   @default("GovtPrep Editorial Team")
  readTime    String   @default("8 min read")
  content     String
  relatedExam String?
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Bookmark {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType  String   // JOB, EXAM, ARTICLE, STUDY_MATERIAL, MOCK_TEST
  itemId    String
  itemTitle String
  itemSlug  String
  createdAt DateTime @default(now())

  @@unique([userId, itemType, itemId])
}

model JobAlert {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  qualification     String?
  state             String?
  category          String?
  emailNotification Boolean  @default(true)
  inAppNotification Boolean  @default(true)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  type      String   @default("JOB") // JOB, EXAM, RESULT, ADMIT_CARD, MOCK_TEST, SYSTEM
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Advertisement {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  placement   String    // TOP_BANNER, HOMEPAGE_MID, JOB_SIDEBAR, ARTICLE_INLINE, FOOTER_BANNER
  imageUrl    String?
  targetUrl   String?
  scriptCode  String?
  isGoogleAd  Boolean   @default(false)
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean   @default(true)
  impressions Int       @default(0)
  clicks      Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PageView {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  path      String
  referrer  String?
  userAgent String?
  createdAt DateTime @default(now())
}

model SiteSetting {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model TechJob {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  slug            String   @unique
  company         String
  companyLogo     String?
  location        String   @default("Bangalore / Remote")
  workMode        String   @default("Remote") // Remote, Hybrid, Onsite
  experienceLevel String   @default("Fresher (0-1 Yrs)") // Fresher, 1-3 Yrs, 3-5 Yrs, Senior
  salaryRange     String   @default("₹6 - ₹12 LPA")
  ctcNumeric      Float?   // in LPA e.g. 12.0
  roleCategory    String   @default("Software Engineering") // Software Engineering, Data & AI, Cloud & DevOps, Cybersecurity, Mobile, QA
  techStack       String   @default("React, Node.js, TypeScript") // comma-separated
  jobType         String   @default("Full Time") // Full Time, Contract
  description     String
  requirements    String?
  eligibility     String?  // B.Tech, BCA, MCA, B.Sc
  applyUrl        String
  isFeatured      Boolean  @default(false)
  isPsuGovt       Boolean  @default(false) // If true, e.g. ISRO Scientist, NIC, CDAC, BEL, DRDO
  status          String   @default("PUBLISHED")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TechCourse {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  title               String
  slug                String   @unique
  provider            String   @default("GovtPrep Academy") // e.g. IIT Madras NPTEL, Coursera, freeCodeCamp, Meta
  instructor          String?
  category            String   @default("Full Stack Development") // Web Dev, AI & Data Science, Cloud, DSA, Cyber Security
  level               String   @default("Beginner to Advanced")
  durationHours       Int      @default(40)
  priceType           String   @default("FREE") // FREE, CERTIFIED, PAID
  priceAmount         Float    @default(0.0)
  certificateIncluded Boolean  @default(true)
  rating              Float    @default(4.8)
  totalStudents       Int      @default(12500)
  thumbnailUrl        String?
  description         String
  syllabus            String?  // JSON or Markdown topics
  prerequisites       String?
  enrollUrl           String
  isFeatured          Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Internship {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  slug            String   @unique
  company         String
  companyLogo     String?
  location        String   @default("Remote / India")
  workMode        String   @default("Remote") // Remote, Hybrid, Onsite
  durationMonths  Int      @default(3)
  stipendAmount   Float?   // monthly in INR e.g. 25000
  stipendDisplay  String   @default("₹25,000 / Month")
  isPpoOffered    Boolean  @default(true) // Pre-Placement Offer
  roleCategory    String   @default("Software Development")
  skillsRequired  String   @default("Python, React, SQL")
  eligibility     String   @default("Pre-final / Final Year College Students (B.Tech / BCA / MCA / B.Sc)")
  description     String
  applyDeadline   DateTime?
  applyUrl        String
  isFeatured      Boolean  @default(false)
  isGovtFellowship Boolean @default(false) // e.g. NIC, ISRO, NITI Aayog Internship
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
